# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Privacy hashing salt — change this; rotate invalidates unique visitor continuity
USTATS_HASH_SALT=replace-with-a-long-random-string

# Public URL of this ustats install (used in embed snippets)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — required for the dashboard AI assistant (gpt-5.4-nano)
OPENAI_API_KEY=sk-your-openai-api-key

# Self-host: hide Create account and reject signUp (also disable Email sign-ups in Supabase Auth)
DISABLE_SIGNUP=true

# Self-host: create the first admin on boot when Auth has zero users, then remove these
USTATS_BOOTSTRAP_EMAIL=admin@example.com
USTATS_BOOTSTRAP_PASSWORD=change-me-to-a-strong-password

# Self-host: optional phrase to reset password while signed in (Settings → Security)
USTATS_RECOVERY_PHRASE=replace-with-a-long-random-phrase
